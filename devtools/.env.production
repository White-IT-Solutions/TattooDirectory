# Tattoo Directory Local Environment Configuration
# Copy this file to .env.local and customize as needed

# Port Configuration (customize to avoid conflicts)
FRONTEND_PORT=3000
BACKEND_PORT=9000
SWAGGER_PORT=8080
LOCALSTACK_PORT=4566
LOCALSTACK_EXTERNAL_PORT_START=4510
LOCALSTACK_EXTERNAL_PORT_END=4559

# Resource Limits (adjust based on your system)
LOCALSTACK_MEMORY_LIMIT=1536M
LOCALSTACK_PHASE2_MEMORY_LIMIT=2G
BACKEND_MEMORY_LIMIT=512M
FRONTEND_MEMORY_LIMIT=1G
SWAGGER_MEMORY_LIMIT=64M

# LocalStack Configuration
LOCALSTACK_DEBUG=1
LOCALSTACK_PERSISTENCE=1
LOCALSTACK_VOLUME_DIR=./localstack-data

# Phase Configuration (phase1 = default, phase2 = includes SQS/EventBridge/CloudWatch)
LOCALSTACK_PHASE=phase1

# Phase 1 Services: DynamoDB, OpenSearch, S3, API Gateway, Lambda, CloudWatch Logs, SNS
LOCALSTACK_PHASE1_SERVICES=dynamodb,opensearch,s3,apigateway,lambda,iam,secretsmanager,logs,sns

# Phase 2 Services: All Phase 1 + SQS, EventBridge, CloudWatch Metrics
LOCALSTACK_PHASE2_SERVICES=dynamodb,opensearch,s3,apigateway,lambda,iam,secretsmanager,logs,sns,sqs,events,cloudwatch

# Enhanced LocalStack Configuration
DYNAMODB_STREAMS_ENABLED=true
CLOUDWATCH_LOGS_RETENTION_DAYS=7
SNS_TOPICS_AUTO_CREATE=true
SQS_DELAY_RECENTLY_DELETED=0

# Service Endpoint Configuration (for container-to-container communication)
LOCALSTACK_INTERNAL_ENDPOINT=http://localstack:4566
DYNAMODB_INTERNAL_ENDPOINT=http://localstack:4566
OPENSEARCH_INTERNAL_ENDPOINT=http://tattoo-directory-opensearch:9200
S3_INTERNAL_ENDPOINT=http://localstack:4566
LAMBDA_INTERNAL_ENDPOINT=http://localstack:4566
LOGS_INTERNAL_ENDPOINT=http://localstack:4566
SNS_INTERNAL_ENDPOINT=http://localstack:4566
SQS_INTERNAL_ENDPOINT=http://localstack:4566
EVENTS_INTERNAL_ENDPOINT=http://localstack:4566
CLOUDWATCH_INTERNAL_ENDPOINT=http://localstack:4566
APIGATEWAY_INTERNAL_ENDPOINT=http://localstack:4566

# Service Endpoint Configuration (for host-to-container communication)
LOCALSTACK_EXTERNAL_ENDPOINT=http://localhost:4566
DYNAMODB_EXTERNAL_ENDPOINT=http://localhost:4566
OPENSEARCH_EXTERNAL_ENDPOINT=http://localhost:4571
S3_EXTERNAL_ENDPOINT=http://localhost:4566
LAMBDA_EXTERNAL_ENDPOINT=http://localhost:4566
LOGS_EXTERNAL_ENDPOINT=http://localhost:4566
SNS_EXTERNAL_ENDPOINT=http://localhost:4566
SQS_EXTERNAL_ENDPOINT=http://localhost:4566
EVENTS_EXTERNAL_ENDPOINT=http://localhost:4566
CLOUDWATCH_EXTERNAL_ENDPOINT=http://localhost:4566
APIGATEWAY_EXTERNAL_ENDPOINT=http://localhost:4566

# Development Configuration
NODE_ENV=development
NEXT_TELEMETRY_DISABLED=1
NEXT_PUBLIC_GOOGLE_MAPS_API_KEY=xxx

# AWS LocalStack Configuration
AWS_ACCESS_KEY_ID=test
AWS_SECRET_ACCESS_KEY=test
AWS_DEFAULT_REGION=eu-west-2
DYNAMODB_TABLE_NAME=tattoo-directory-local
OPENSEARCH_ENDPOINT=http://localhost:4571

# File Watching (platform-specific, auto-detected)
WATCHPACK_POLLING=true
CHOKIDAR_USEPOLLING=true
CHOKIDAR_INTERVAL=1000

# Docker Configuration
COMPOSE_PROJECT_NAME=tattoo-directory
COMPOSE_FILE=docker-compose.local.yml

# Platform-specific overrides (auto-detected)
# COMPOSE_FILE=docker-compose.local.yml:docker-compose.windows.yml  # Windows
# COMPOSE_FILE=docker-compose.local.yml:docker-compose.macos.yml    # macOS
# COMPOSE_FILE=docker-compose.local.yml:docker-compose.linux.yml    # Linux
