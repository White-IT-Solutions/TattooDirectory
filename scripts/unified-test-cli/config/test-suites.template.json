{
  "testSuites": [
    {
      "name": "example-unit",
      "displayName": "Example Unit Tests",
      "description": "Example unit test suite configuration",
      "type": "unit",
      "workspace": "example-workspace",
      "command": "npm test",
      "requiredServices": [],
      "dataScenario": null,
      "timeout": 300000,
      "canRunParallel": true,
      "supportsCoverage": true,
      "tags": ["unit", "example"]
    },
    {
      "name": "example-integration",
      "displayName": "Example Integration Tests",
      "description": "Example integration test suite configuration",
      "type": "integration",
      "workspace": "tests/integration",
      "command": "npm test",
      "requiredServices": ["localstack"],
      "dataScenario": "minimal",
      "timeout": 600000,
      "canRunParallel": true,
      "supportsCoverage": true,
      "tags": ["integration", "example"]
    },
    {
      "name": "example-e2e",
      "displayName": "Example E2E Tests",
      "description": "Example end-to-end test suite configuration",
      "type": "e2e",
      "workspace": "tests/e2e",
      "command": "npm test",
      "requiredServices": ["localstack", "frontend", "backend"],
      "dataScenario": "frontend-ready",
      "timeout": 900000,
      "canRunParallel": false,
      "supportsCoverage": false,
      "tags": ["e2e", "example"]
    }
  ],
  "_documentation": {
    "description": "Test suite configuration template for the Unified Test CLI",
    "fields": {
      "name": {
        "type": "string",
        "required": true,
        "description": "Unique identifier for the test suite (kebab-case recommended)"
      },
      "displayName": {
        "type": "string",
        "required": true,
        "description": "Human-readable name displayed in CLI output"
      },
      "description": {
        "type": "string",
        "required": true,
        "description": "Brief description of what the test suite covers"
      },
      "type": {
        "type": "string",
        "required": true,
        "enum": [
          "unit",
          "integration",
          "e2e",
          "security",
          "performance",
          "contract"
        ],
        "description": "Type of test suite for categorization and filtering"
      },
      "workspace": {
        "type": "string",
        "required": true,
        "description": "Path to npm workspace relative to project root"
      },
      "command": {
        "type": "string",
        "required": true,
        "description": "Command to execute the tests (run from workspace directory)"
      },
      "requiredServices": {
        "type": "array",
        "required": false,
        "default": [],
        "description": "List of services that must be running before tests execute"
      },
      "dataScenario": {
        "type": "string|null",
        "required": false,
        "default": null,
        "description": "Data scenario to seed before running tests (null for no seeding)"
      },
      "timeout": {
        "type": "number",
        "required": false,
        "default": 300000,
        "description": "Test timeout in milliseconds"
      },
      "canRunParallel": {
        "type": "boolean",
        "required": false,
        "default": true,
        "description": "Whether this suite can run in parallel with other suites"
      },
      "supportsCoverage": {
        "type": "boolean",
        "required": false,
        "default": true,
        "description": "Whether this suite supports coverage reporting"
      },
      "tags": {
        "type": "array",
        "required": false,
        "default": [],
        "description": "Tags for filtering and categorization"
      }
    }
  }
}
