{
  "name": "unified-test-cli",
  "version": "1.0.0",
  "description": "Unified CLI interface for running all test suites with environment validation and data scenario management",
  "main": "src/cli/index.js",
  "type": "module",
  "scripts": {
    "start": "node src/cli/index.js",
    "test": "jest --forceExit",
    "test:watch": "jest --watch --forceExit",
    "test:coverage": "jest --coverage --forceExit",
    "test:cli": "jest src/__tests__/cli --testTimeout=120000",
    "test:cli:integration": "jest src/__tests__/cli/integration.test.js --testTimeout=120000",
    "test:cli:e2e": "jest src/__tests__/cli/e2e.test.js --testTimeout=120000",
    "test:cli:performance": "jest src/__tests__/cli/performance.test.js --testTimeout=120000",
    "test:cli:errors": "jest src/__tests__/cli/error-scenarios.test.js --testTimeout=120000",
    "test:cli:comprehensive": "jest src/__tests__/cli/comprehensive.test.js --testTimeout=120000",
    "test:cli:all": "node src/__tests__/cli/run-all-tests.js"
  },
  "dependencies": {
    "@aws-sdk/client-dynamodb": "^3.901.0",
    "@aws-sdk/client-s3": "^3.901.0",
    "axios": "^1.6.0",
    "chalk": "^5.3.0",
    "commander": "^11.0.0",
    "inquirer": "^9.2.0",
    "ora": "^7.0.0"
  },
  "devDependencies": {
    "@babel/preset-env": "^7.22.0",
    "@jest/globals": "^29.7.0",
    "babel-jest": "^29.7.0",
    "babel-plugin-transform-import-meta": "^2.2.1",
    "cross-env": "^7.0.3",
    "jest": "^29.7.0"
  },
  "babel": {
    "presets": [
      [
        "@babel/preset-env",
        {
          "targets": {
            "node": "current"
          },
          "modules": false
        }
      ]
    ],
    "env": {
      "test": {
        "presets": [
          [
            "@babel/preset-env",
            {
              "targets": {
                "node": "current"
              },
              "modules": "commonjs"
            }
          ]
        ]
      }
    }
  }
}
